/target
**/*.rs.bk
Cargo.lock.orig

# Generated fixtures and fitted artifacts. Corpora are never committed:
# only fitted profiles with a provenance manifest are shareable, and even
# those need a privacy review when derived from private data.
/fixtures/demo/
*.jsonl
!crates/**/tests/**/*.jsonl

# Python eval harness
__pycache__/
*.egg-info/
.venv/

/corpus/

# Battery corpora and build output. Four of the five battery authors are in
# copyright and the Folger TEI is non-commercial; `eval/licenses/check.py`
# fails the build if anything under these is ever tracked.
/eval/corpora/*
!/eval/corpora/README.md
!/eval/corpora/chapterize.py
/eval/raw/
/eval/build/
/eval/experiments/voice-transfer/artifacts/
